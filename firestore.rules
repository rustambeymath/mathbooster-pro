rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔐 ADMIN UID — может писать ВЕЗДЕ
    function isAdmin() {
      return request.auth != null && request.auth.uid == '9RapHM80aPWOfspjOR5uvhVHriF2';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // 🚫 БАН-ЛИСТ — динамический список banned_users/{authUID}
    // + хардкод старых UID как страховка
    function isBanned() {
      return request.auth != null && (
        request.auth.uid == '1rBstYZgAAR7YjhIGegcwT9kfPV2'
        || request.auth.uid == '2ocWWmfpANNmPk1vInBpnBHfUBH3'
        || exists(/databases/$(database)/documents/banned_users/$(request.auth.uid))
      );
    }

    // ============================================
    // 📋 ПРОФИЛИ ПОЛЬЗОВАТЕЛЕЙ
    // 🔒 ПАТЧ ЧТЕНИЯ: get — ТОЛЬКО владелец (или админ). Раньше get был открыт
    // всем вошедшим (так работали родительский дашборд и восстановление) —
    // это позволяло любому вошедшему точечно прочитать ЧУЖОЙ профиль:
    // history/subjects/служебные поля. Теперь родительский дашборд и
    // восстановление ходят через Cloud Functions (parentGet/transferGet),
    // которые проверяют код доступа на сервере. Листинг — только админу
    // (поиск по имени в админке).
    // ============================================
    match /users/{userId} {
      allow get: if isAdmin()
        || resource.data.get('_ownerUID', '') == request.auth.uid
        // 🩹 ЛЕГАСИ-ПЕРЕХОД: старые профили без _ownerUID (~70 доков) читаются
        // любым вошедшим ДО первого сейва — иначе их владелец не может войти
        // (вход = чтение своего профиля, а самоклеймить чтением нельзя).
        // Первый же Data.save ставит _ownerUID (storage.js) — документ
        // само-мигрирует и закрывается владельцем. Перебор id нереален (лист закрыт),
        // rescueCode из всех профилей уже вычищен (scrubRescue).
        || !('_ownerUID' in resource.data);
      allow list: if isAdmin();

      // ⚠️ УРОК 26.09: request.resource.data при update — это СЛИТЫЙ документ
      // (существующие поля + оверлей), поэтому проверка по нему позволяла УГОН
      // профиля: атакующий присылает полный setDoc со СВОИМ _ownerUID, слитый
      // документ проходит проверку, и владелец подменяется. Смотрим владельца
      // СУЩЕСТВУЮЩЕГО документа (resource.data) и запрещаем его смену.
      allow create: if isSignedIn() && !isBanned()
        && request.resource.data.get('_ownerUID', '') == request.auth.uid;

      allow update: if isSignedIn() && !isBanned() && (
        (resource.data.get('_ownerUID', '') == request.auth.uid
          && request.resource.data.get('_ownerUID', '') == resource.data.get('_ownerUID', ''))
        // 🩹 Самоклейма легаси-профиля без _ownerUID (~70 старых игроков, для них
        // новый старт таймера падал с 403). Документ адресуется по игровому id,
        // полный setDoc клиента несёт auth UID владельца: чужой док «клеймить»
        // незачем и незачем нельзя без перезаписи чужих данных, накрутка отсечена
        // античитом. Осознанный остаточный риск, альтернатива — скрипт-клейм.
        || (!('_ownerUID' in resource.data)
            && request.resource.data.get('_ownerUID', '') == request.auth.uid)
        || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ============================================
    // 🏆 ТАБЛИЦА ЛИДЕРОВ (публичная визитка)
    // Каждый пишет ТОЛЬКО в свою карточку и только разумные значения.
    // Анти-фарм: totalSec ограничен 13ч на одну запись (сессия + защита
    // от склеенных сейвов); скорость прироста проверяет сервер (antiCheatLeaderboard).
    // ============================================
    match /leaderboard/{userId} {
      // 🔒 ПАТЧ УТЕЧКИ: чтение карточки — по точному id под входом (листинга нет).
      // fcmToken из карточек уже вычищен adminAction scrubRescue; после закрытия
      // users.get ничего чувствительного в карточке не остаётся.
      allow get, list: if isSignedIn() && !isBanned();

      allow create: if isSignedIn() && !isBanned() && (
        request.resource.data._ownerUID == request.auth.uid
        || isAdmin()
      )
      && (
        isAdmin()
        || (
          request.resource.data.totalSec is int
          && request.resource.data.totalSec >= 0
          // 🩹 исключение: точное значение уже проверенного античитом профиля
          // (восстановление по коду, оффлайн-догон) — иначе карточка нового
          // устройства замерзает навсегда (дельта > 13ч)
          && (request.resource.data.totalSec <= 60 * 60 * 13
              || request.resource.data.totalSec == get(/databases/$(database)/documents/users/$(userId)).data.user.totalSec)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 20
          && request.resource.data.level is int
          && request.resource.data.level >= 0
          && request.resource.data.level <= 100
          // 🔒 ПЕРЕХОДНО: старый клиент (кэш PWA) пишет fcmToken в каждый setDoc —
          // жёсткий запрет ломал ВЕСЬ Data.save() и часы в Топе. Новый клиент токен
          // не пишет. ПОСЛЕ пуша нового клиента вернуть:
          // && !(request.resource.data.get('fcmToken', null) is string)
        )
      );

      // ⚠️ ВАЖНО (урок регрессии 25.09): updateDoc() с маской приходит в правила
      // как overlay — request.resource.data содержит ТОЛЬКО обновляемые поля.
      // Валидация по наличию: каждое поле проверяется, только если оно реально
      // пришло в записи. Иначе точечные updateDoc({lastActive}) получают 403 и
      // Топ «замерзает».
      allow update: if isSignedIn() && !isBanned() && (
        // штатный владелец: существующий owner == я, запись не меняет owner
        (resource.data.get('_ownerUID', '') == request.auth.uid
          && request.resource.data.get('_ownerUID', '') == resource.data.get('_ownerUID', ''))
        // 🩹 САМОЛЕЧЕНИЕ (замершие карточки): карточка осиротела или владелец
        // сменился (переустановка PWA, восстановление по коду → новый auth UID).
        // Возвращаем карточку тому, чей профиль users/{userId} жив и принадлежит
        // ему. Профиль защищён угон-фиксом, так что подделать доказательство нельзя.
        || (request.resource.data.get('_ownerUID', '') == request.auth.uid
            && get(/databases/$(database)/documents/users/$(userId)).data._ownerUID == request.auth.uid)
        || isAdmin()
      )
      && (
        isAdmin()
        || (
          (!('totalSec' in request.resource.data)
            || (request.resource.data.totalSec is int
                && request.resource.data.totalSec >= 0
                // 🩹 синхронизация с проверенным профилем снимает 13ч-дельту:
                // админ-коррекции и оффлайн-догон больше не замораживают карточку
                && (request.resource.data.totalSec - resource.data.totalSec <= 60 * 60 * 13
                    || request.resource.data.totalSec == get(/databases/$(database)/documents/users/$(userId)).data.user.totalSec)))
          && (!('name' in request.resource.data)
            || (request.resource.data.name is string
                && request.resource.data.name.size() > 0
                && request.resource.data.name.size() <= 20))
          && (!('level' in request.resource.data)
            || (request.resource.data.level is int
                && request.resource.data.level >= 0
                && request.resource.data.level <= 100))
          // 🔒 ПОСЛЕ пуша нового клиента (он не пишет fcmToken) вернуть запрет:
          // && (!('fcmToken' in request.resource.data) || request.resource.data.fcmToken == null)
        )
      );

      allow delete: if isAdmin();
    }

    // ============================================
    // 🧊 АРХИВ СЕЗОНОВ (замороженные таблицы лидеров)
    // Читать — все. Писать карточку может ТОЛЬКО её владелец
    // (иначе кто угодно переписывает чужие результаты прошлого сезона).
    // Клиент пишет _ownerUID при заморозке; чужие карточки пропускает тихо.
    // Динамически поддерживаем сезоны 1..5 (на будущее).
    // ============================================
    match /leaderboard_history_1/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && !isBanned() && (
        request.resource.data.get('_ownerUID', '') == request.auth.uid
        || resource.data.get('_ownerUID', '') == request.auth.uid
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /leaderboard_history_2/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && !isBanned() && (
        request.resource.data.get('_ownerUID', '') == request.auth.uid
        || resource.data.get('_ownerUID', '') == request.auth.uid
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /leaderboard_history_3/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && !isBanned() && (
        request.resource.data.get('_ownerUID', '') == request.auth.uid
        || resource.data.get('_ownerUID', '') == request.auth.uid
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ============================================
    // 🔄 КОДЫ ВОССТАНОВЛЕНИЯ (transfers) — 🔒 ПАТЧ УГНАНА
    // Раньше: read = true + в data лежал ПОЛНЫЙ профиль → любой
    // перебирал/листил коды и восстанавливал чужой аккаунт.
    // Теперь: профиль в облако пишет только Cloud Function reserveRescueCode,
    // клиент хранит РЕЕСТР кодов у себя (localStorage), а восстановление
    // и родительский режим получают данные через transferGet (сервер
    // возвращает профиль только по точному коду; листинга нет).
    // ============================================
    match /transfers/{code} {
      // 🔒 ЗАКРЫТО ПОЛНОСТЬЮ: восстановление и родительский режим ходят через
      // Cloud Function transferGet (проверка кода/токена на сервере).
      allow get, list: if false;

      // 🔒 ПЕРЕХОДНЫЙ ПЕРИОД ЗАВЕРШЁН: клиент не пишет transfers (только CF
      // transferGet через Admin SDK). Прямой доступ закрыт полностью.
      allow create: if false;

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);

      allow update: if isSignedIn() && !isBanned()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'updatedAt'])
        && resource.data.userId == request.auth.uid;

      allow delete: if isAdmin();
    }

    // ============================================
    // 🎟️ ПРОМО-КОДЫ (только админ)
    // ============================================
    match /promo_codes/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // ⚔️ PVP БИТВЫ (battles_v2)
    // ============================================
    match /battles_v2/{roomCode} {
      allow read: if true;

      allow create: if isSignedIn() && !isBanned() && request.resource.data.keys().hasAll(['p1', 'p1_id', 'status']);

      // ⚠️ ОСТАВЛЕНО пермиссивным осознанно: id в комнатах — игровые (у легаси
      // не равны auth UID), серверной авторитетности дуэлей пока нет.
      // Известный остаточный риск (низкий): подписанный юзер может портить состояния
      // комнат — лечится будущим переводом дуэлей на Cloud Functions.
      allow update: if isSignedIn() && !isBanned();

      // Удалять может создатель ИЛИ админ
      allow delete: if (isSignedIn() && !isBanned()) || isAdmin();
    }

    // ============================================
    // ⚔️ ВЫЗОВЫ НА ДУЭЛЬ (pendingChallenges)
    // Документ адресуется по игровому id игрока, который у легаси/
    // восстановленных профилей не совпадает с Firebase Auth UID.
    // Документы одноразовые и содержат только имя/аватар/код комнаты.
    // ============================================
    match /pendingChallenges/{challengeId} {
      allow read: if isSignedIn() && !isBanned();
      allow create: if isSignedIn() && !isBanned();
      // ⚠️ ОСТАВЛЕНО пермиссивным осознанно: документы-вызовы эфемерны (≤35 сек,
      // сами чистятся) и адресованы игровому id, который у легаси ≠ auth UID.
      // Окно для злоупотреблений — секунды, влияние минимально.
      allow update, delete: if isSignedIn() && !isBanned();
    }

    // ============================================
    // 🎟️ FCM-ТОКЕНЫ РОДИТЕЛЕЙ (parentTokens/{childCode}/tokens/{fcmToken})
    // Пишет родитель из режима родителя (привязка пушей к ребёнку).
    // Читать может только Cloud Functions (клиентские правила запрещают).
    // ============================================
    match /parentTokens/{childCode} {
      allow read: if false; // Cloud Functions (Admin SDK) игнорируют правила

      match /tokens/{token} {
        allow read: if false;
        allow create: if isSignedIn() && !isBanned()
          && request.resource.data.keys().hasAll(['token'])
          && request.resource.data.token is string
          && request.resource.data.token.size() <= 200;
        allow update, delete: if isSignedIn() && !isBanned();
      }
    }

    // ============================================
    // ⏱️ АНТИ-АФК ТАЙМЕР (timerChecks / afk_checks)
    // Запись о том, что игрок прошёл проверку «живости» во время длинной сессии.
    // ============================================
    match /timerChecks/{docId} {
      allow read: if isSignedIn() && !isBanned();
      allow create: if isSignedIn() && !isBanned();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /afk_checks/{docId} {
      allow read: if isSignedIn() && !isBanned();
      allow create: if isSignedIn() && !isBanned();
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
