rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔐 ADMIN UID — может писать ВЕЗДЕ
    function isAdmin() {
      return request.auth != null && request.auth.uid == '9RapHM80aPWOfspjOR5uvhVHriF2';
    }

    // ============================================
    // 📋 ПРОФИЛИ ПОЛЬЗОВАТЕЛЕЙ
    // ============================================
    match /users/{userId} {
      allow read: if true;
      
      // Владелец пишет в свой профиль ИЛИ админ пишет куда угодно
      allow write: if request.auth != null && (
        request.resource.data._ownerUID == request.auth.uid  // Владелец
        || isAdmin()                                          // Админ
      );
      
      allow create: if request.auth != null && (
        request.resource.data._ownerUID == request.auth.uid
        || isAdmin()
      );
    }

    // ============================================
    // 🏆 ТАБЛИЦА ЛИДЕРОВ
    // ============================================
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.resource.data._ownerUID == request.auth.uid
        || isAdmin()
      );
    }

    // ============================================
    // 🔄 КОДЫ ВОССТАНОВЛЕНИЯ (transfers)
    // ============================================
    match /transfers/{code} {
      allow read: if true;
      
      allow create: if request.resource.data.keys().hasAll(['userId', 'data', 'createdAt']);
      
      allow update: if request.auth != null && (
        request.resource.data.userId == request.auth.uid
        || isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    // ============================================
    // 🎟️ ПРОМО-КОДЫ
    // ============================================
    match /promo_codes/{code} {
      allow read: if true;
      allow write: if isAdmin();  // Только админ
    }

    // ============================================
    // ⚔️ PVP БИТВЫ (battles_v2)
    // ============================================
    match /battles_v2/{roomCode} {
      allow read: if true;
      
      allow create: if request.auth != null && request.resource.data.keys().hasAll(['p1', 'p1_id', 'status']);
      
      // Любой авторизованный может обновлять (для PVP дуэлей)
      allow update: if request.auth != null;
      
      // Удалять может создатель ИЛИ админ
      allow delete: if request.auth != null;
    }

    // ============================================
    // ⚔️ ВЫЗОВЫ НА ДУЭЛЬ (pendingChallenges)
    // ============================================
    match /pendingChallenges/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
